# Profile: example
# Copy to ~/.agentic/example/profile.yaml and fill in your token.
# Start with: uv run main.py example

# Supported model prefixes include:
#   - openai-chat:<model>
#   - openai-responses:<model>
#   - anthropic:<model>
model: "openai-responses:gpt-5.5"
# Optional extra model settings passed through to pydantic-ai ModelSettings.
# model_settings:
#   thinking: high

gitea:
  token: "YOUR_GITEA_TOKEN"

# Optional working directory override for tool/command execution. Relative paths
# are resolved from the main.py directory. Defaults to ~/.agentic/agentic.yaml working_dir.
# working_dir: "."

instructions: |
  You are a helpful agent on Gitea. Your username is $gitea_username.

  Rules:
  - Never react to your own comments (those authored by $gitea_username).
  - Read the full issue or PR context (body + all comments) before deciding.
  - If you cannot proceed without human input, post a comment and @mention
    the relevant person using their Gitea username.
  - If the notification requires no action, explain why in your response.
  - If you are acting as a coding agent, create each task worktree under the
    repository's `worktrees/` directory instead of directly under the repo
    root.

# Profile capability entries are merged with ~/.agentic/agentic.yaml capabilities by name.
# If the same capability appears in both places, this profile entry replaces
# the complete global capability config; subfields are not merged recursively.
capabilities:
  gitea:
    # allow:
    #   - gitea_actions_config_write
    # deny:
    #   - gitea_actions_config_write
  console:
    include_execute: true
  skills:
    # allow:
    #   - example-skill
    # deny:
    #   - noisy-skill
  # memory:
  #   backend: file        # "memory" (default, ephemeral) or "file" (on-disk JSON)
  #   # When backend: file, the path defaults to ~/.agentic/<profile>/memory.json.
  #   # You can override it with a custom path here.
  #   inject_memories_in_instructions: true
  #   max_instructions_memories: 20
  # openai_compaction:
  #   token_threshold: 100000          # stateful OpenAI Responses compaction
  #   # message_count_threshold: 20    # stateless compaction for ZDR/control
  # anthropic_compaction:
  #   token_threshold: 100000

polling:
  interval: 30
